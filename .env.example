# Copy to .env and fill in. Never commit the real .env.

# Required for anything beyond local play. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Local development
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_TIME_ZONE=Asia/Riyadh

# Optional AI (natural-language add, receipt scan, chat, advice, forecast wording).
# The app runs fine without it — those features show a friendly message instead.
# AI_PROVIDER: auto (Gemini if a key is set, else Ollama if a URL is set), gemini, ollama, or none.
AI_PROVIDER=auto

# Hosted: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local and free: Ollama (https://ollama.com), for example `ollama pull qwen2.5vl:3b`
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5vl:3b
AI_TIMEOUT=180

# Default display currency for new accounts: USD, JOD, or SAR
SMART_SPEND_DEFAULT_CURRENCY=USD
